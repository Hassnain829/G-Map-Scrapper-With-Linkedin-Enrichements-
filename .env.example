# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env": it holds your API key.

# --- ContactOut (email lookup) -------------------------------------------
CONTACTOUT_API_KEY=

# --- Files ----------------------------------------------------------------
INPUT_TERMS_FILE=input.txt
GOOGLE_MAPS_OUTPUT=google_maps_data.csv
ENRICHED_OUTPUT=enriched_leads.csv

# --- Run defaults (the web dashboard overrides these per run) -------------
HEADLESS=false
RESUME=true
TOTAL_MAP_RESULTS=3
ENRICH_LIMIT=3

# --- Pacing (seconds) -----------------------------------------------------
MAPS_DELAY_SECONDS=2
WEBSITE_DELAY_SECONDS=0.25
WEBSITE_MAX_PAGES=6
GOOGLE_SEARCH_DELAY_SECONDS=10
BING_SEARCH_DELAY_SECONDS=4
GOOGLE_OPEN_RESULT_LIMIT=4
GOOGLE_QUERY_LIMIT_PER_BUSINESS=4

# --- Web search for owner / founder / CEO ---------------------------------
# Engines are tried in this order; one that shows a CAPTCHA is paused for
# SEARCH_ENGINE_COOLDOWN_MINUTES and the next engine is used.
SEARCH_ENGINE_ORDER=bing,google
SEARCH_ENGINE_COOLDOWN_MINUTES=12

# --- ContactOut behaviour -------------------------------------------------
CONTACTOUT_ENABLE=true
CONTACTOUT_EMAIL_TYPE=personal,work
CONTACTOUT_EXHAUSTIVE_LOOKUP=true
CONTACTOUT_V1_BATCH_FALLBACK=true
CONTACTOUT_PEOPLE_SEARCH_FALLBACK=true
CONTACTOUT_PEOPLE_ENRICH_FALLBACK=false
CONTACTOUT_SEARCH_PAGE_SIZE=5
# Finds the owner by company domain; does not use email-reveal quota.
CONTACTOUT_DECISION_MAKERS_FALLBACK=true

# --- Facebook / social email fallback -------------------------------------
SCRAPE_FACEBOOK_EMAILS=true
SCRAPE_SOCIAL_EMAILS=false
FACEBOOK_BROWSER_FALLBACK=true

# --- Optional -------------------------------------------------------------
# BROWSER_CHANNEL=chrome        # or "msedge"; empty = bundled Chromium
# BROWSER_PROFILE_DIR=.chromium_profile
# OUTPUT_DIR=outputs
